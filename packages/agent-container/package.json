{
  "name": "@clawdbox/agent-container",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Codex runner container for Cloudflare Containers",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "effect": "^3.19.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
