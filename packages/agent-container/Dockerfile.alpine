# Alternative Claude Agent SDK Container for Cloudflare Containers
# Uses alpine base image (cached locally) + manual bun installation
# Use this when Docker Hub is unreachable

FROM alpine:3.17

# System dependencies
RUN apk add --no-cache \
    git \
    curl \
    openssh-client \
    ca-certificates \
    bash \
    nodejs \
    npm \
    unzip \
    gcompat

# Install bun from GitHub releases (avoids Docker Hub)
RUN curl -fsSL https://bun.sh/install | bash && \
    ln -s /root/.bun/bin/bun /usr/local/bin/bun && \
    ln -s /root/.bun/bin/bunx /usr/local/bin/bunx

# Install claude-code CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Create workspace directories
RUN mkdir -p /workspace /agent

# Set up agent runtime
WORKDIR /agent
COPY package.json ./
RUN bun install

# Copy agent source
COPY src/ ./src/
COPY dist/ ./dist/ 2>/dev/null || mkdir -p ./dist

# Configure git for operations
RUN git config --global user.email "agent@clawdbox.ai" && \
    git config --global user.name "Clawdbox Agent"

# Set working directory to workspace for agent operations
WORKDIR /workspace

# Expose port for health checks and callbacks
EXPOSE 8080

# Entrypoint runs the agent
ENTRYPOINT ["bun", "run", "/agent/dist/entrypoint.js"]
